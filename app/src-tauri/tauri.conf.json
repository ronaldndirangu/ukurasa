{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ukurasa",
  "identifier": "app.ukurasa.Ukurasa",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ukurasa",
        "width": 1200,
        "height": 800,
        "minWidth": 480,
        "minHeight": 360
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost pdf: http://pdf.localhost data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "pdfium/": "pdfium/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
